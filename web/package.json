{
  "name": "b9s-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test --test-timeout=20000 tests/api.test.mjs",
    "test:guards": "node --test --test-timeout=20000 tests/poll-guard.mjs",
    "test:e2e": "npm run test:api && npm run test:guards && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mermaid": "11.17.2"
  }
}
