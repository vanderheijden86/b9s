pkgname=b9s-bin
pkgver=1.3.5
pkgrel=1
pkgdesc='Terminal and web UI for Beads issues'
arch=('x86_64' 'aarch64')
url='https://github.com/vanderheijden86/b9s'
license=('MIT')
depends=('glibc')
optdepends=('beads: issue editing and embedded Dolt projects'
            'xdg-utils: open links and attachments')
provides=("b9s=${pkgver}")
conflicts=('b9s')
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${pkgver}/b9s_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/b9s_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('2097463963a19821336402560b31fbda3cc52ec4a12fd85354cc91bccb6c57ae')
sha256sums_aarch64=('04997bac05c7e40c4f2c1b62a3fda4e5e3b3a9acd1263212d3ce18b3bed4624d')

package() {
  install -Dm755 "${srcdir}/b9s" "${pkgdir}/usr/bin/b9s"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
